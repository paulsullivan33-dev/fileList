#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"
if [[ -z "${PYTHON_BIN:-}" && -x ".venv/bin/python" ]]; then
    PYTHON_BIN=".venv/bin/python"
else
    PYTHON_BIN="${PYTHON_BIN:-python3}"
fi

# run.sh runs this check in the foreground (./start --check) before it starts
# the launcher in the background, and sets FILELIST_PRECHECKED so the slow SSH
# probe is not repeated. An unreachable remote destination is only a warning.
if [[ -z "${FILELIST_PRECHECKED:-}" ]]; then
    "$PYTHON_BIN" tools/check_config.py --ssh
fi
if [[ "${1:-}" == "--check" ]]; then
    exit 0
fi

worker_pid=""
app_pid=""

cleanup() {
    [[ -n "$app_pid" ]] && kill "$app_pid" 2>/dev/null || true
    [[ -n "$worker_pid" ]] && kill "$worker_pid" 2>/dev/null || true
    wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

"$PYTHON_BIN" job_worker.py &
worker_pid=$!
"$PYTHON_BIN" app.py &
app_pid=$!

wait -n "$worker_pid" "$app_pid"
