# Only reviewed project files are eligible for normal git add operations.
# Local configuration, credentials, data, dist/, caches and environments stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/INSTALL.md
!/requirements.txt
!/start
!/run.sh
!/stop.sh
!/actions.py
!/archive_ops.py
!/app.py
!/auth.py
!/browser.py
!/config_loader.py
!/job_store.py
!/job_worker.py
!/manage_user.py
!/operation_log.py
!/transfer_preview.py
!/folder_listing.py
!/worker_health.py
!/config_backups.py
!/remote_copy.py
!/styles.py
!/uploads.py
!/utils.py
!/directories.example.json
!/users.example.json
!/remote_destinations.example.json
!/external_sites.example.json
!/tests/
/tests/*
!/tests/test_remote_copy.py
!/tests/test_browser.py
!/tests/test_safety.py
!/tests/test_config_check.py
!/tests/test_convert.py
!/tests/test_create_text.py
!/tests/test_archives.py
!/tests/test_job_identity.py
!/tests/test_transfers.py
!/tests/test_uploads.py
!/tests/test_operation_log.py
!/tests/test_transfer_preview.py
!/tests/test_linux_integration.py
!/tests/test_pagination.py
!/tests/test_queue.py
!/tests/test_worker_health.py
!/tests/test_config_backups.py
!/tests/test_run_scripts.py
!/tools/
/tools/*
!/tools/install.py
!/tools/build_release.py
!/tools/check_config.py
!/tools/config_backup.py

# Never include generated Python files, even within allowed directories.
__pycache__/
*.py[cod]
